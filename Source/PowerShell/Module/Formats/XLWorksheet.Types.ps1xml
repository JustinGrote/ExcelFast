<?xml version="1.0" encoding="utf-8"?>
<Types>
    <Type>
        <Name>ClosedXML.Excel.XLWorksheet</Name>
        <Members>
            <ScriptProperty>
                <Name>Rows</Name>
                <GetScriptBlock>
                    @($this.RowsUsed()).count
                </GetScriptBlock>
            </ScriptProperty>
            <ScriptProperty>
                <Name>Columns</Name>
                <GetScriptBlock>
                    @($this.ColumnsUsed()).count
                </GetScriptBlock>
            </ScriptProperty>
            <ScriptProperty>
                <Name>IsProtected</Name>
                <GetScriptBlock>
                    $this.Protection.IsProtected
                </GetScriptBlock>
            </ScriptProperty>
        </Members>
    </Type>
</Types>
